# ============================================
# Dictionnaire Wôlinak — .gitignore
# RÈGLE D'OR : les DONNÉES du dictionnaire ne
# vont JAMAIS sur GitHub. Seulement le code.
# La base vit dans Supabase, point.
# ============================================

# Dumps et exports de données
*.json
!package.json
words_dump*.json
*.csv
*.xlsx

# Sauvegardes locales de la base
backup*/
backups/
*.bak
*.sql

# Fichiers temporaires
*.tmp
*.log
~$*
.DS_Store
Thumbs.db

# Dépendances (si ajoutées un jour)
node_modules/

# Reconnaissance vocale: les voix, consentements, modèles et jeux générés
# restent locaux. Seuls le code, le schéma et les exemples fictifs sont suivis.
speech-recognition/corpus/audio/
speech-recognition/corpus/consents/
speech-recognition/build/
speech-recognition/models/
speech-recognition/.venv/
__pycache__/
*.pyc
